{
  "schema": "chrono-output-retention/v2",
  "max_lifetime_seconds": 86400,
  "producers": {
    "cache-probe-attempt": [
      ".chrono-harness/state/cache-probes/"
    ],
    "cache-plan": [
      ".chrono-harness/state/cache/"
    ]
  },
  "keep_seconds": 0,
  "diagnostic_keep_seconds": 86400,
  "max_related_outputs": 512,
  "max_summaries": 128,
  "max_nodes_per_round": 256,
  "max_bytes_per_round": 67108864,
  "max_millis_per_round": 25,
  "max_output_bytes": 1073741824,
  "metadata_keep_seconds": 86400,
  "max_manifest_nodes": 16384,
  "max_metadata_bytes_per_round": 67108864,
  "terminal_limits": {
    "cache-probe-attempt": {
      "keep_seconds": 86400,
      "max_count": 32,
      "max_bytes": 67108864,
      "metadata_keep_seconds": 0
    },
    "cache-plan": {
      "keep_seconds": 86400,
      "max_count": 32,
      "max_bytes": 67108864,
      "metadata_keep_seconds": 0
    }
  }
}
