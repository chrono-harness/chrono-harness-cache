{
  "schema": "chrono-github-cache-actions/v1",
  "jobs": {
    "check": {
      "command": [
        "./check.sh"
      ],
      "action_path": ".github/actions/native-check/action.yml"
    }
  },
  "persistent_cache": {
    "schema": "chrono-github-cache/v1",
    "program": ".chrono-harness/bin/chrono-cache",
    "config": ".chrono-harness/cache.json",
    "restore_action": "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830",
    "save_action": "actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830",
    "save_on_push_only": false,
    "jobs": {
      "check": {
        "need": "Reuse compilations of the cache binary and its dedicated Rust tests.",
        "output_use": "Cargo checks restored inputs and runs the native tests and Verus proofs.",
        "consumer": "native-check",
        "prepare": [
          "mkdir",
          "-p",
          "target/native-cargo"
        ],
        "caches": [
          "cargo-download",
          "cargo-target"
        ],
        "save_caches": [
          "cargo-download",
          "cargo-target"
        ]
      }
    }
  }
}
