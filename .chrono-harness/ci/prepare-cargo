#!/usr/bin/env bash
set -euo pipefail
mkdir -p .chrono-harness/bin
ln -s "$(mise which chrono-cache)" .chrono-harness/bin/chrono-cache
ln -s "$(mise which chrono-harness)" .chrono-harness/bin/chrono-harness
jq -er '"CARGO_INCREMENTAL=" + .build.incremental' .chrono-harness/ci/cargo.json >> "$GITHUB_ENV"
printf 'CHRONO_RUSTUP=%s\n' "$(command -v rustup)" >> "$GITHUB_ENV"
